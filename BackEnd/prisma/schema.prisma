datasource db {
  provider = "postgresql"
}

generator client {
  provider   = "prisma-client"
  output     = "./generated"
  runtime    = "cloudflare"
  engineType = "client"
}

enum AppointmentStatus {
  CONFIRMADO
  CANCELADO
}

enum UserRole {
  MASTER
  ADMIN
  BARBER
}

enum ServiceCategory {
  CORTE
  BARBA
  SOBRANCELHA
  PINTURA
  COMBO
}

model Barbershop {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String   @default("")
  whatsapp    String?
  imageUrl    String?
  instagram   String?
  facebook    String?
  tiktok      String?
  createdAt   DateTime @default(now())

  barbers     Barber[]
  serviceTopics ServiceTopic[]
}

model User {
  id       Int      @id @default(autoincrement())
  email    String   @unique
  password String
  role     UserRole @default(BARBER)
  barberId Int?     @unique

  barber Barber? @relation(fields: [barberId], references: [id], onDelete: SetNull)
}

model Barber {
  id            Int      @id @default(autoincrement())
  name          String
  description   String
  slug          String   @unique
  whatsapp      String?
  imageUrl      String?
  instagram     String?
  facebook      String?
  tiktok        String?
  barbershopId  Int

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  user         User?
  services     Service[]
  schedules    Schedule[]
  scheduleTemplates ScheduleTemplate[]
  appointments Appointment[]

  @@index([barbershopId])
}

model Service {
  id       Int             @id @default(autoincrement())
  name     String
  price    Float           @default(0)
  barberId Int?
  category ServiceCategory @default(CORTE)
  topicId Int?

  barber       Barber?              @relation(fields: [barberId], references: [id], onDelete: SetNull)
  topic        ServiceTopic?        @relation(fields: [topicId], references: [id], onDelete: SetNull)
  appointments AppointmentService[]
  comboItems   ServiceComboItem[]   @relation("ComboService")
  includedInCombos ServiceComboItem[] @relation("IncludedService")

  @@index([barberId])
  @@index([barberId, category])
  @@index([topicId])
  @@unique([barberId, name])
}

model ServiceTopic {
  id          Int      @id @default(autoincrement())
  name        String
  description String   @default("")
  imageUrl    String?
  barbershopId Int
  createdAt   DateTime @default(now())

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  services   Service[]

  @@unique([barbershopId, name])
  @@index([barbershopId])
}

model ServiceComboItem {
  comboId     Int
  serviceId   Int

  combo       Service @relation("ComboService", fields: [comboId], references: [id], onDelete: Cascade)
  service     Service @relation("IncludedService", fields: [serviceId], references: [id], onDelete: Restrict)

  @@id([comboId, serviceId])
  @@index([serviceId])
}

model ScheduleTemplate {
  id       Int    @id @default(autoincrement())
  time     String
  barberId Int

  barber   Barber   @relation(fields: [barberId], references: [id], onDelete: Cascade)
  schedules Schedule[]

  @@index([barberId])
  @@unique([barberId, time])
}

model Schedule {
  id          Int       @id @default(autoincrement())
  date        DateTime
  time        String
  barberId    Int
  templateId  Int?
  appointment Appointment?

  barber   Barber            @relation(fields: [barberId], references: [id])
  template ScheduleTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([barberId, date])
  @@unique([barberId, date, time])
  @@index([templateId])
}

model Appointment {
  id            Int               @id @default(autoincrement())
  customerName  String
  customerPhone String
  description   String?
  status        AppointmentStatus @default(CONFIRMADO)
  barberId      Int
  scheduleId    Int               @unique
  createdAt     DateTime          @default(now())

  services AppointmentService[]

  barber   Barber   @relation(fields: [barberId], references: [id])
  schedule Schedule @relation(fields: [scheduleId], references: [id])
}

model AppointmentService {
  appointmentId Int
  serviceId     Int
  price         Float @default(0)

  appointment Appointment @relation(fields: [appointmentId], references: [id])
  service     Service     @relation(fields: [serviceId], references: [id])

  @@id([appointmentId, serviceId])
}
